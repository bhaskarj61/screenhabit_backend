{
  "name": "screenhabit-backend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import=tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node --env-file=.env --import=tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "local": "tsx src/local.ts",
    "config:local": "tsx scripts/update-local-policy.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
