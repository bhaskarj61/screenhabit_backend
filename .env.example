# Local development only. Use a strong, unique password on your server.
DATABASE_URL=postgresql://screenhabit:local-only-change-me@localhost:5432/screenhabit
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# false for local Docker; use true and a trusted certificate for managed remote DBs.
DATABASE_SSL=false
# Optional PEM CA certificate file for a managed database.
# DATABASE_CA_FILE=/run/secrets/database-ca.pem
# Set to 1 ONLY if exactly one trusted reverse proxy fronts the API.
TRUST_PROXY_HOPS=0
